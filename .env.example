# FXBrief backend — Phase 1C environment variables.
# Copy this file to .env on the server and replace the placeholder values.

DB_URL=jdbc:postgresql://localhost:5432/fxbrief
DB_USERNAME=fxbrief
DB_PASSWORD=change-me

# JWT signing secret for HS256. Must be at least 32 bytes (256 bits).
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-bytes-of-random-secret-value

# Base URL of the Angular frontend. Used both for the CORS allowed-origins
# list and to compose verification/password-reset links written to the
# application log (email delivery is introduced in Phase 5A).
FRONTEND_BASE_URL=https://app.fxbrief.example

# Google OAuth 2.0 Web client ID issued in Google Cloud Console.
# Used as the audience claim when verifying Google ID tokens posted to
# /auth/google. The Angular frontend uses the same client ID when
# requesting tokens from Google Identity Services.
#
# A single value is the common case. If you ever need to accept ID tokens
# from more than one Google OAuth client (e.g. a separate mobile client),
# provide a comma-separated list:
#   GOOGLE_OAUTH_CLIENT_ID=web-id.apps.googleusercontent.com,ios-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-web-client-id.apps.googleusercontent.com
